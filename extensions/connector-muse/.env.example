# Example environment for the Muse connector.
# Copy to .env (0600) or export directly. The ONLY credential-adjacent value
# here is COTAL_CREDS — a PATH to a 0600 minted creds file, never a secret.

# Mesh space (must match the space the creds were minted for)
COTAL_SPACE=main

# This connector's principal: owner.actor on the mesh
COTAL_OWNER=arena
COTAL_ACTOR=muse

# Optional role tag carried in the from.role field
# COTAL_ROLE=

# REQUIRED: path to the minted creds file (0600), from `cotal mint --provision`
COTAL_CREDS=/path/to/muse.creds

# REQUIRED: lifecycle uid printed by `cotal mint --provision`
COTAL_LIFECYCLE_UID=

# Broker URL (default nats://127.0.0.1:4222)
# COTAL_SERVER=nats://127.0.0.1:4222

# Connector working dir (inbox/, outbox/, sent/, quarantine/, state.json live here)
MUSE_CONNECTOR_DIR=./connectors/muse

# Optional comma-separated channels to also listen on (needs --allow-subscribe at mint)
# COTAL_CHANNELS=bot-chat,alerts

# Poll interval for the mesh↔file loop (ms). Latency floor for both directions.
POLL_INTERVAL_MS=15000

# Presence heartbeat interval (ms). Upstream default is 2000/6000 TTL.
PRESENCE_INTERVAL_MS=2000

# Beads CLI binary used for /claim and /release intents
# BD_BIN=bd
